# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Database (Postgres do docker-compose)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ytboxd
DB_PASSWORD=ytboxd
DB_DATABASE=ytboxd
# Só para Postgres na nuvem (Neon, Supabase): DB_SSL=true
# DB_SSL=true
